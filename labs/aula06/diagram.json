{
  "version": 1,
  "author": "Acervo M04 IN",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": -100, "left": 160, "attrs": { "color": "red", "label": "lacre" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 160, "left": -150, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": 160, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 90, "left": 190, "attrs": { "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:4", "btn1:1.l", "blue", [ "h0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h0" ] ],
    [ "esp:2", "r1:2", "green", [ "h0" ] ],
    [ "r1:1", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "pot1:SIG", "esp:34", "orange", [ "v0" ] ],
    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
